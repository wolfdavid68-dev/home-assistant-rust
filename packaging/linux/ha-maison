#!/bin/sh
# Lance une commande du serveur de la maison (comme « ha-server … ») avec
# les réglages et le compte du service. Installé par installer.sh dans
# /usr/local/bin. Exemples :
#
#   sudo ha-maison user add david
#   sudo ha-maison hue pair 192.168.1.10
#   sudo ha-maison backup list
#
# Guide : docs/mini-pc.md
set -eu

if [ "$(id -u)" -ne 0 ]; then
  echo "à lancer avec sudo : sudo ha-maison $*" >&2
  exit 1
fi

# Le compte « ha-maison » n'a pas de shell : runuser lance la commande en
# son nom, avec les réglages du service, dans son dossier.
exec runuser -u ha-maison -- /bin/sh -c '
  set -a
  if [ -r /etc/ha-maison/ha-maison.auto.env ]; then
    . /etc/ha-maison/ha-maison.auto.env
  fi
  . /etc/ha-maison/ha-maison.env
  set +a
  cd /var/lib/ha-maison
  exec /opt/ha-maison/ha-server "$@"
' ha-maison "$@"
