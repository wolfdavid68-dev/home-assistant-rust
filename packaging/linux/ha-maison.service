# Le serveur de la maison, en service systemd (mini-PC sous Debian).
# Installé par installer.sh dans /etc/systemd/system/. Guide : docs/mini-pc.md
#
#   sudo systemctl status ha-maison      est-il en marche ?
#   sudo journalctl -u ha-maison -f      voir le journal
#   sudo systemctl restart ha-maison     relire les réglages
#
# Les réglages sont dans /etc/ha-maison/ha-maison.env ; pour changer ce
# fichier-ci, mieux vaut « sudo systemctl edit ha-maison » (gardé lors des
# mises à jour).

[Unit]
Description=Serveur de la maison (home-assistant-rust)
Documentation=https://github.com/wolfdavid68-dev/home-assistant-rust/blob/main/docs/mini-pc.md
Wants=network-online.target
After=network-online.target time-sync.target

[Service]
Type=simple
User=ha-maison
Group=ha-maison
# Le compteur Linky sur un module USB (/dev/ttyUSB0).
SupplementaryGroups=dialout
# Les réglages faits par l'installation (MQTT, voix), puis les tiens, qui
# passent devant (étape 83).
EnvironmentFile=-/etc/ha-maison/ha-maison.auto.env
EnvironmentFile=/etc/ha-maison/ha-maison.env
ExecStart=/opt/ha-maison/ha-server
WorkingDirectory=/var/lib/ha-maison

# Les dossiers où le serveur peut écrire, créés par systemd pour lui seul :
# la base, la clé qui chiffre ses secrets (à part), les sauvegardes.
StateDirectory=ha-maison ha-maison-cle ha-maison-sauvegardes
StateDirectoryMode=0700
UMask=0077

# Redémarre tout seul s'il s'arrête sur une erreur. Laisse le temps
# d'enregistrer les derniers états à l'arrêt.
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

# Une limite de mémoire large : le serveur prend ~40 Mo, la voix ~200 Mo.
MemoryMax=1G
TasksMax=256

# Durcissement : le programme ne voit et ne peut toucher que le nécessaire.
# Seul droit gardé : écouter sur le port 80 (Alexa en local).
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
# Les appareils : rien, sauf les ports série USB (module Linky).
DevicePolicy=closed
DeviceAllow=char-ttyUSB rw
DeviceAllow=char-ttyACM rw
# Réseau : IPv4, IPv6, et netlink pour connaître l'adresse de la machine
# (annonces Sonos).
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
