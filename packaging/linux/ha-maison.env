# Réglages du serveur de la maison (mini-PC). Guide : docs/mini-pc.md
#
# Une ligne par réglage, NOM=valeur, sans espace autour du « = » ni dans la
# valeur. Enlève le « # » devant une ligne pour l'activer, puis :
#   sudo systemctl restart ha-maison
#
# Ce fichier n'est jamais remplacé par une mise à jour.

# Le tableau de bord, ouvert au réseau de la maison (téléphones, tablette).
# Ne redirige JAMAIS ce port depuis ta box Internet : pour l'accès à
# distance, un VPN (voir docs/etape-7-deploiement.md).
HA_BIND=0.0.0.0:8123

# HTTPS sur le réseau de la maison (voir docs/https-maison.md) : les mots de
# passe ne circulent plus en clair sur le Wi-Fi. Le certificat de la maison
# s'installe une fois sur chaque appareil : http://<adresse>:8123/maison-ca.crt
# Pour d'autres noms ou adresses dans le certificat (.local ou privées) :
# HA_TLS_NOMS=maison.local,192.168.1.21
HA_TLS=on

# Où sont rangées les données (ne pas changer).
HA_DB_PATH=/var/lib/ha-maison/ha.db
HA_KEY_PATH=/var/lib/ha-maison-cle/ha.key
HA_BACKUP_DIR=/var/lib/ha-maison-sauvegardes

# Tes fichiers de réglages, dans /etc/ha-maison (des exemples sont à côté,
# en .example.yaml).
HA_AUTOMATIONS_PATH=/etc/ha-maison/automations.yaml
HA_AREAS_PATH=/etc/ha-maison/areas.yaml
HA_GUARD_PATH=/etc/ha-maison/guard.yaml
HA_SCRIPTS_PATH=/etc/ha-maison/scripts.yaml
HA_SCENES_PATH=/etc/ha-maison/scenes.yaml
HA_ALEXA_PATH=/etc/ha-maison/alexa.yaml
HA_THERMOSTATS_PATH=/etc/ha-maison/thermostats.yaml
HA_PERSONS_PATH=/etc/ha-maison/persons.yaml
HA_INPUTS_PATH=/etc/ha-maison/inputs.yaml
HA_DERIVED_PATH=/etc/ha-maison/derived.yaml
HA_ENERGY_PATH=/etc/ha-maison/energy.yaml
HA_CALENDARS_PATH=/etc/ha-maison/calendriers.yaml
HA_SIMULATION_PATH=/etc/ha-maison/simulation.yaml
HA_DELESTAGE_PATH=/etc/ha-maison/delestage.yaml
HA_TEMPLATES_PATH=/etc/ha-maison/modeles.yaml
HA_RAPPELS_PATH=/etc/ha-maison/rappels.yaml
HA_PROTECTION_SOLAIRE_PATH=/etc/ha-maison/protection-solaire.yaml

TZ=Europe/Paris
RUST_LOG=info

# Position de la maison, pour le soleil (deux décimales suffisent) :
#HA_LATITUDE=48.85
#HA_LONGITUDE=2.35
# Météo locale avec Open-Meteo (voir docs/meteo.md), il faut la position :
#HA_METEO=on

# Sauvegardes automatiques : heure et nombre gardé.
#HA_BACKUP_TIME=03:30
#HA_BACKUP_KEEP=7

# Éditeur d'automatisations en lecture seule (voir docs/editeur-automatisations.md) :
#HA_AUTOMATION_EDITOR=off

# Notifications sur le téléphone avec ntfy (voir docs/notifications.md) :
#HA_NTFY_URL=https://ntfy.sh
#HA_NTFY_TOPIC=maison-un-sujet-long-et-aleatoire
#HA_NTFY_TOKEN_FILE=/etc/ha-maison/secrets/ntfy_token

# Alexa en local (voir docs/alexa.md) : l'adresse de ce mini-PC, et celles
# de tes Echo :
#HA_ALEXA_IP=192.168.1.20
#HA_ALEXA_ALLOWED=192.168.1.40,192.168.1.41

# Vigilance Météo-France (voir docs/vigilance.md) : ton département, et la
# clé de l'API dans un fichier à part :
#HA_VIGILANCE_DEPARTEMENT=67
#HA_VIGILANCE_KEY_FILE=/etc/ha-maison/secrets/meteofrance

# Broker MQTT (étape 4), facultatif :
#HA_MQTT_HOST=192.168.1.20
#HA_MQTT_USER=ha-server
#HA_MQTT_PASSWORD_FILE=/etc/ha-maison/secrets/mqtt_password

# Enceintes Sonos et annonces vocales (voir docs/sonos.md) : la voix,
# installée dans /opt/ha-maison/piper avec fr_FR-siwis-medium.onnx à côté
# (voir docs/mini-pc.md) :
#HA_SONOS=auto
#HA_PIPER=/opt/ha-maison/piper/piper

# Compteur Linky (voir docs/energie.md) : module USB, ou module réseau :
#HA_TELEINFO=/dev/ttyUSB0
#HA_TELEINFO=tcp://192.168.1.50:3333
